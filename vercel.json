{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run check:schema && next build",
  "installCommand": "npm ci",
  "regions": [
    "iad1"
  ],
  "crons": [
    {
      "path": "/api/cron/tv-ingest",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/daily-scan",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/classify",
      "schedule": "0 8 * * *"
    }
  ]
}
