# ---------------------------------------------------------------------------
# WatchVerdict environment variables
# Copy to .env.local for local dev, and set these in Vercel for production.
# NEVER commit real values. Only NEXT_PUBLIC_* are exposed to the browser.
# ---------------------------------------------------------------------------

# --- Supabase (public, browser-safe) ---------------------------------------
# Project: WatchVerdict (ref vajgviraxigkwlvysxfz)
NEXT_PUBLIC_SUPABASE_URL=https://vajgviraxigkwlvysxfz.supabase.co
# Use the "publishable" (anon) key. Browser-safe by design.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (server-only, SECRET) ----------------------------------------
# Service-role key. Server-only. NEVER prefix with NEXT_PUBLIC_.
# Only used by trusted server routes (e.g. account deletion). Optional for
# core usage; required for the account-deletion endpoint.
SUPABASE_SERVICE_ROLE_KEY=

# --- TMDB (server-only, SECRET) --------------------------------------------
# A TMDB API Read Access Token (v4 bearer) OR a v3 API key.
# Get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Site URL (public) ------------------------------------------------------
# The canonical public URL. Used for auth redirects, share links, OG tags.
# Local: http://localhost:3000 — Production: your Vercel/prod URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- OpenAI (server-only, OPTIONAL) ----------------------------------------
# Enhances report prose only. The app produces full deterministic verdicts
# without it. Leave blank to disable AI prose.
OPENAI_API_KEY=

# --- OMDb (server-only, OPTIONAL) ------------------------------------------
# Adds critic aggregator ratings (IMDb rating, Rotten Tomatoes, Metacritic).
# Free key at https://www.omdbapi.com/apikey.aspx . The app works fully without
# it (TMDB audience data only); when present, verdicts include critic scores.
OMDB_API_KEY=

# --- Daily digest scan (server-only) ---------------------------------------
# Secret that protects the daily new-release scan endpoint (/api/cron/daily-scan).
# Set to any long random string; Vercel Cron sends it automatically. Required to
# enable the daily "New for you" scan.
CRON_SECRET=

# --- Resend email (server-only, OPTIONAL) ----------------------------------
# Enables emailing the daily digest. Free key at https://resend.com . Without it,
# the daily matches still appear in-app under "New for you" — just no email.
RESEND_API_KEY=

# --- TV listings — TVmaze (server-only, no key needed) ----------------------
# TVmaze needs no credentials at all — it's what actually feeds the ingest
# (/api/cron/tv-ingest -> src/lib/viewing/ingest/) into tv_providers/
# tv_lineups/tv_stations/tv_programmes/tv_airings. Nothing to set here.

# --- TV listings — TV Media (server-only, SECRET, currently unused) --------
# The code already reads these (src/lib/viewing/adapters/tvMedia.ts,
# src/lib/viewing/liveTv.ts) for the query-time Live TV chain, but this
# adapter has no real account behind it yet and stays unconfigured/dormant —
# see docs/SCHEDULE_PROVIDERS.md. Listed here so the template matches what
# the code actually expects; setting these does not affect the TVmaze ingest.
TVMEDIA_API_KEY=
TVMEDIA_LINEUP_ID=
TVMEDIA_DEFAULT_ZIP=
TVMEDIA_BASE_URL=

# --- TV listings — Schedules Direct (server-only, SECRET, currently unused) -
# Same status as TV Media above: the code expects these
# (src/lib/viewing/adapters/schedulesDirect.ts) but no account is configured.
# $25/year at https://www.schedulesdirect.org if this is ever turned on —
# see docs/SCHEDULE_PROVIDERS.md for the full setup steps.
SCHEDULES_DIRECT_USERNAME=
SCHEDULES_DIRECT_PASSWORD=
SCHEDULES_DIRECT_LINEUP=
