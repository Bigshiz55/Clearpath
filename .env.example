# ---------------------------------------------------------------------------
# WatchVerdict environment variables
# Copy to .env.local for local dev, and set these in Vercel for production.
# NEVER commit real values. Only NEXT_PUBLIC_* are exposed to the browser.
# ---------------------------------------------------------------------------

# --- Supabase (public, browser-safe) ---------------------------------------
# Project: WatchVerdict (ref vajgviraxigkwlvysxfz)
NEXT_PUBLIC_SUPABASE_URL=https://vajgviraxigkwlvysxfz.supabase.co
# Use the "publishable" (anon) key. Browser-safe by design.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (server-only, SECRET) ----------------------------------------
# Service-role key. Server-only. NEVER prefix with NEXT_PUBLIC_.
# Only used by trusted server routes (e.g. account deletion). Optional for
# core usage; required for the account-deletion endpoint.
SUPABASE_SERVICE_ROLE_KEY=

# --- TMDB (server-only, SECRET) --------------------------------------------
# A TMDB API Read Access Token (v4 bearer) OR a v3 API key.
# Get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Site URL (public) ------------------------------------------------------
# The canonical public URL. Used for auth redirects, share links, OG tags.
# Local: http://localhost:3000 — Production: your Vercel/prod URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- OpenAI (server-only, OPTIONAL) ----------------------------------------
# Enhances report prose only. The app produces full deterministic verdicts
# without it. Leave blank to disable AI prose.
OPENAI_API_KEY=

# --- OMDb (server-only, OPTIONAL) ------------------------------------------
# Adds critic aggregator ratings (IMDb rating, Rotten Tomatoes, Metacritic).
# Free key at https://www.omdbapi.com/apikey.aspx . The app works fully without
# it (TMDB audience data only); when present, verdicts include critic scores.
OMDB_API_KEY=

# --- MDBList (server-only, SECRET) ------------------------------------------
# Aggregated ratings — Rotten Tomatoes audience (Popcornmeter), RT critic, IMDb,
# Metacritic, Trakt, Letterboxd. Optional; the app degrades to whatever other
# ratings sources are present when unset. Free key at https://mdblist.com/ .
MDBLIST_API_KEY=

# --- Watchmode (server-only, SECRET) ----------------------------------------
# Streaming availability — which service(s) carry a title, and a deeplink.
# Get a key at https://api.watchmode.com/. Called ONLY from the daily cron
# sync (src/lib/watchmode/sync.ts -> /api/cron/watchmode-sync), never from a
# user request — title/season pages read the cache Supabase table
# (watchmode_availability), not the live API. Hard-capped at 2,000 calls/
# month (src/lib/watchmode/sync.ts), safely under Watchmode's free-tier 2,500
# — see the module's own comment for why headroom matters. The free tier is
# licensed for NON-COMMERCIAL use only; a paid commercial tier is required
# before any public launch. Leave unset to keep the whole feature dormant —
# cards show "checking availability" and nothing calls out.
WATCHMODE_API_KEY=

# --- Daily digest scan (server-only) ---------------------------------------
# Secret that protects the daily new-release scan endpoint (/api/cron/daily-scan).
# Set to any long random string; Vercel Cron sends it automatically. Required to
# enable the daily "New for you" scan.
CRON_SECRET=

# --- Resend email (server-only, OPTIONAL) ----------------------------------
# Enables emailing the daily digest. Free key at https://resend.com . Without it,
# the daily matches still appear in-app under "New for you" — just no email.
RESEND_API_KEY=

# --- TV listings — TVmaze (server-only, no key needed) ----------------------
# TVmaze needs no credentials at all — it's what actually feeds the ingest
# (/api/cron/tv-ingest -> src/lib/viewing/ingest/) into tv_providers/
# tv_lineups/tv_stations/tv_programmes/tv_airings. Nothing to set here. The
# Hallmark & Lifetime / True Crime Pack pages (/packs/[slug]) also trigger
# this ingest lazily on page load when their data is stale — no separate
# variable needed for that either.

# --- Data mode — the ONE switch that decides what may touch the network ---
# REQUIRED IN PRODUCTION. There is no production default.
#
# fixture    Nothing leaves the box. Every adapter reads generated test data.
#            No credentials, no cost. Fixture rows are never shown to ordinary
#            production users.
# free_live  Free, official, permitted sources may be called — TVmaze today.
#            Metered adapters still cannot spend.
# paid_live  Licensed, metered adapters are permitted to spend — and even then
#            only the ones whose own enable flag is set (see below).
#
# Outside production (local, tests, CI, preview) an unset value resolves to
# `fixture`, because there the safe default is also the useful one.
#
# On a real production deployment an unset or unrecognised value is a
# CONFIGURATION_ERROR and the platform fails CLOSED: zero external provider
# requests, every ingestion adapter disabled, the error reported by name
# through /api/health/tv, and the last stored verified data still served.
# It is never inferred — least of all `paid_live`.
# See src/lib/tv/dataMode.ts.
DATA_MODE=

# --- Metered-adapter authorisation — the SECOND key ---
# A metered adapter needs BOTH `DATA_MODE=paid_live` AND its own flag set to
# exactly "1". Changing the mode alone must never be enough to start a bill,
# which is the accident this pair exists to prevent. Any metered adapter that
# reaches the egress guard while not authorised is logged as [CRITICAL].
TVMEDIA_ENABLED=

# --- TV listings — TV Media (server-only, SECRET) — the PRIMARY provider ---
# TV Media is the licensed primary for the full channel guide: priority 0 in
# the query-time Live TV chain (src/lib/viewing/liveTv.ts) AND the daily
# ingest that writes tv_stations/tv_programmes/tv_airings
# (src/lib/viewing/ingest/tvMediaWriter.ts, run from /api/cron/tv-ingest).
# With TVMEDIA_API_KEY unset, both stay a clean no-op — the guide falls back
# to whatever TVmaze has ingested and says so on screen; see
# docs/SCHEDULE_PROVIDERS.md.
TVMEDIA_API_KEY=
# One of these two is required once the key is set — LINEUP_ID is preferred;
# DEFAULT_ZIP is used only when no lineup id is configured.
TVMEDIA_LINEUP_ID=
TVMEDIA_DEFAULT_ZIP=
# Overrides the API host — set only if TV Media gives you a sandbox endpoint.
TVMEDIA_BASE_URL=
# OPTIONAL. Calls/month your TV Media plan allows. Left at 0 (or unset), no
# budget is enforced — the real plan limit isn't known yet. Once it is, set
# this and the ingest job stops itself (never mid-call) rather than exceed
# it; see the "Cost control" section of docs/SCHEDULE_PROVIDERS.md for the
# expected call volume at the current 14-day/once-daily ingest schedule.
TVMEDIA_MONTHLY_CALL_LIMIT=

# --- TV listings — Schedules Direct (server-only, SECRET, currently unused) -
# Same status as TV Media above: the code expects these
# (src/lib/viewing/adapters/schedulesDirect.ts) but no account is configured.
# $25/year at https://www.schedulesdirect.org if this is ever turned on —
# see docs/SCHEDULE_PROVIDERS.md for the full setup steps.
SCHEDULES_DIRECT_USERNAME=
SCHEDULES_DIRECT_PASSWORD=
SCHEDULES_DIRECT_LINEUP=
